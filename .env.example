# Copie para ".env" e preencha. Nenhum valor abaixo e obrigatorio para rodar.
SITE_DEBUG=true
SITE_HOST=127.0.0.1
SITE_PORT=8000

# Notificacao por e-mail de novos orcamentos (opcional).
# Sem SMTP, os pedidos continuam sendo gravados em data/quotes/quotes.jsonl.
SITE_SMTP_HOST=
SITE_SMTP_PORT=587
SITE_SMTP_USER=
SITE_SMTP_PASSWORD=
SITE_NOTIFY_TO=
